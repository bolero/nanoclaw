# Copy to ~/.config/nanoclaw/gatus-webhook.env and chmod 600. Never commit the real file.
WEBHOOK_SECRET=change-me            # openssl rand -hex 24
WEBHOOK_HOST=100.x.y.z              # this machine's Tailscale IP (tailscale ip -4)
WEBHOOK_PORT=8787
TARGET_CHANNEL_TYPE=telegram
TARGET_PLATFORM_ID=telegram:CHAT_ID # from the Telegram pairing (see data/v2.db / ncl messaging-groups list)
# TARGET_THREAD_ID=                  # optional Telegram topic id
REPEAT_SUPPRESS_MIN=30
RESOLVE_DELAY_SEC=90
